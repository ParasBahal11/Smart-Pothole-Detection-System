PORT=5000

# MongoDB and authentication
MONGO_URI=mongodb://127.0.0.1:27017/smart-pothole
JWT_SECRET=replace-with-a-long-random-secret

# Frontend origin allowed by the backend CORS configuration.
# For Render, use the deployed frontend URL (without /api).
CLIENT_URL=http://localhost:5173

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=replace-with-your-turnstile-secret

# AI service
AI_SERVICE_URL=http://127.0.0.1:8000
AI_URL=http://127.0.0.1:8000

ESCALATION_HOURS=24

# Email OTP via SMTP (Gmail requires 2-Step Verification + a 16-character Google App Password, NOT your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM=RoadGuard <your-email@gmail.com>

# SMS OTP via Twilio. TWILIO_PHONE_NUMBER must be a number bought/assigned by Twilio (not your own mobile).
# Trial accounts can only text numbers verified in the Twilio console.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-your-twilio-auth-token
TWILIO_PHONE_NUMBER=+15551234567

# Local demo helper: print OTP codes in this terminal when email/SMS can't be delivered.
# Ignored automatically when NODE_ENV=production.
OTP_DEV_LOG=true

# Optional admin and contractor seed account values
# (login emails are fake, so give a real inbox to receive their OTP codes)
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@pothole.local
ADMIN_PASSWORD=replace-with-a-strong-password
CONTRACTOR_NAME=City Road Contractor
CONTRACTOR_EMAIL=contractor@pothole.local
CONTRACTOR_PASSWORD=replace-with-a-strong-password
ADMIN_OTP_EMAIL=your-email@gmail.com
CONTRACTOR_OTP_EMAIL=your-email@gmail.com
